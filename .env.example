# ==============================================================================
# VortexAI - Environment Variables Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# Target Host Configuration (for deploy.sh script & docker-compose)
PI_HOST="192.168.1.152"
PI_IP="192.168.1.152"
PI_USER="yanis"
PI_PORT="22"
PI_DIR="~/vortexai"

# Stack General Configuration
COMPOSE_PROJECT_NAME="vortexai"
TIMEZONE="Europe/Paris"

# Evolution API (WhatsApp Gateway)
EVOLUTION_API_KEY="evolution_secret_key_12345"
EVOLUTION_PORT="8080"
DATABASE_CONNECTION_URI="postgresql://postgres:postgres_password@postgres:5432/evolution_db?schema=evolution_api"

# n8n Automation Engine
N8N_PORT="5678"
N8N_ENCRYPTION_KEY="n8n_encryption_secret_key_12345"

# FreeLLMAPI Routing
FREELLMAPI_PORT="3001"
FREELLMAPI_KEY="freellmapi_secret_key_12345"
FREELLMAPI_ENCRYPTION_KEY="change_me_freellmapi_64_hex_chars_encryption_key_here"

# AnythingLLM (Knowledge Management / RAG)
ANYTHINGLLM_PORT="3000"
